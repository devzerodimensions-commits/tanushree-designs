# ---- Server ----
PORT=5050
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ---- PostgreSQL ----
# Either provide DATABASE_URL, or the individual PG* values below.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tanushree_designs
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=tanushree_designs
PGSSL=false

# ---- Auth ----
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Default admin (created by npm run db:seed) ----
ADMIN_NAME=Tanushree Admin
ADMIN_EMAIL=admin@tanushreedesigns.in
ADMIN_PASSWORD=Admin@12345

# ---- Uploads ----
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8

# Set to 1 when using the PGlite dev database (npm run db:dev), which
# serves a single connection. Leave unset/10 for a real PostgreSQL server.
PG_POOL_MAX=10

# Public read cache lifetime in ms (cleared automatically on any admin write)
CACHE_TTL_MS=60000
